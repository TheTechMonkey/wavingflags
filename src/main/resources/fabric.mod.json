  "authors": [
    "TechMonkey"
  ],
  "contact": {
    "sources": "https://github.com/TheTechMonkey/wavingflags"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.techmonkey.wavingflags.WavingFlags"
    ],
    "client": [
      "com.techmonkey.wavingflags.client.WavingFlagsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
